# Rozgar — Environment Configuration
# Copy to .env and fill in your values, then run with --dart-define

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google Maps (optional — OSM fallback without it)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# AI Providers (optional — hardcoded defaults used without them)
# Groq is primary (fast, free tier), Mistral is fallback
GROQ_API_KEY=your-groq-api-key
MISTRAL_API_KEY=your-mistral-api-key
